{
  "name": "@patimweb/pi-tape",
  "version": "1.1.2",
  "description": "Record pi agent sessions, play them back deterministically, and splice them into composable recipes",
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent",
    "session",
    "replay",
    "determinism",
    "recipes",
    "tape"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/pi-tape.git"
  },
  "bugs": {
    "url": "https://github.com/Smotherer007/pi-tape/issues"
  },
  "homepage": "https://github.com/Smotherer007/pi-tape#readme",
  "bin": {
    "pi-tape": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --test 'test/**/*.test.ts'",
    "test:watch": "node --test --watch 'test/**/*.test.ts'",
    "test:coverage": "node --experimental-test-coverage --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "typebox": "^1.3.35",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@semantic-release/git": "^10.0.0",
    "@types/node": "^26.5.1",
    "semantic-release": "^25.0.0",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ]
  }
}
