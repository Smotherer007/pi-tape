# Dependencies are installed from the lockfile, never vendored.
node_modules/

# Project-local tape library and recordings. The global one lives in
# ~/.pi/agent/tape/, this is the per-project override.
.tape/

# Local recordings
*.tape

# Mind Place knowledge graph: derived from the sources, regenerable, large.
graph-out/

# Compiled CLI and extension: built by `npm run build` before publishing.
dist/

# Editor and OS noise
.DS_Store
*.log
*.tsbuildinfo
